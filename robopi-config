do_test_serial() {
  local ports=$(ls /dev/ttyS* /dev/ttyAMA* /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ')
  if [ -z "$ports" ]; then
    whiptail --msgbox "Serial: FAILED - No serial ports found" 8 50
    return
  fi

  # Find kernel console port
  local console=""
  console=$(cat /proc/consoles 2>/dev/null | head -1 | sed -n 's/.*tty\([^ ]*\).*/\1/p' || true)
  [ -z "$console" ] && console=$(cat /proc/cmdline 2>/dev/null | sed -n 's/.*console=tty\([^ ,]*\).*/\1/p' | cut -d, -f1 || true)

  # Build menu array (workaround: use flat string, replace spaces in label)
  local menu_items=""
  for p in $ports; do
    local name=$(basename "$p")
    local label="-"
    if [ "$name" = "$console" ]; then
      label="[CONSOLE-cannot-test]"
    elif systemctl -q is-active "serial-getty@${name}.service" 2>/dev/null; then
      label="[GETTY-disable-first]"
    fi
    menu_items="${menu_items} ${name} ${label}"
  done

  local port
  port=$(whiptail --title "Serial Port Test" --menu \
    "Select port. [KERNEL_CONSOLE]=system port, cannot test.\nUSB serial adapter (ttyUSB*) is best for loopback:" \
    16 65 8 --cancel-button Back --ok-button Test ${menu_items} 3>&1 1>&2 2>&3)
  local port_ret=$?
  [ $port_ret -ne 0 ] && return
  [ -z "$port" ] && return

  local dev="/dev/$port"

  # Check console
  if [ "$port" = "$console" ]; then
    whiptail --msgbox "$dev is the KERNEL CONSOLE.\n\n\
This port is used by the system for U-Boot/kernel messages.\n\
It cannot be used for loopback testing.\n\n\
Try /dev/ttyUSB0 (USB serial adapter) instead.\n\
Short TX/RX pins on the USB adapter with a jumper." 14 65
    return
  fi

  # Ready to test

  while true; do
    local action
    action=$(whiptail --title "Serial Test: $port" --menu \
      "Port: $dev\n\nSelect test action:" 17 65 5 --cancel-button Back \
      "1" "View port settings (stty)" \
      "2" "Send test data" \
      "3" "Listen for data (10s)" \
      "4" "Loopback test (Python, short TX+RX)" \
      3>&1 1>&2 2>&3)
    local act_ret=$?
    [ $act_ret -ne 0 ] && return

    case "$action" in
      1)
        local info=$(format_stty "$dev")
        whiptail --msgbox "$info" 22 72
        ;;
      2)
        local baud=$(whiptail --inputbox "Baud rate:" 8 50 "115200" 3>&1 1>&2 2>&3)
        [ -z "$baud" ] && continue
        stty -F "$dev" "$baud" raw -echo 2>/dev/null
        local msg=$(whiptail --inputbox "Data to send:" 8 60 "Hello" 3>&1 1>&2 2>&3)
        [ -n "$msg" ] && printf '%s\r\n' "$msg" > "$dev" && \
          whiptail --msgbox "Sent: $msg @ ${baud}bps" 8 50
        ;;
      3)
        local baud=$(whiptail --inputbox "Baud rate:" 8 50 "115200" 3>&1 1>&2 2>&3)
        [ -z "$baud" ] && continue
        stty -F "$dev" "$baud" raw -echo 2>/dev/null
        local tmp=$(mktemp)
        timeout 5 cat "$dev" > "$tmp" 2>/dev/null &
        local pid=$!
        whiptail --gauge "Listening on $dev @ ${baud}bps... (5s)" 8 50 0 < <(
          for i in 0 20 40 60 80 100; do sleep 1; echo $i; done
        )
        wait $pid 2>/dev/null
        local data=$(cat "$tmp" 2>/dev/null | tr -dc '[:print:]\n')
        [ -n "$data" ] && data="$data" || data="(no data received)"
        whiptail --msgbox "Received:\n${data}" 16 70
        rm -f "$tmp"
        ;;
      4)
        whiptail --yesno "Loopback Test for $dev\n\n\
1. Physically SHORT the TX and RX pins\n\
2. Type a line, press Enter to send\n\
3. What you type will loop back and appear as RX\n\
4. Empty line (just Enter) to finish\n\n\
Ready to test?" 14 60 || continue

        local baud=$(whiptail --inputbox "Baud rate:" 8 50 "115200" 3>&1 1>&2 2>&3)
        [ -z "$baud" ] && continue

        stty -F "$dev" "$baud" raw -echo min 0 time 2 2>/dev/null

        clear
        printf '\033[1;36m══════ Loopback Test ══════\033[0m\n'
        printf 'Port: %-10s  Baud: %-8s    (empty line = exit)\n' "$dev" "$baud"
        printf '──────────────────────────────────\n'

        while true; do
          printf '\033[1;33mTX>\033[0m '
          IFS= read -r line
          if [ -z "$line" ]; then
            printf '\nLoopback test ended.\n'
            break
          fi

          # Start background reader before sending
          local rxtmp=$(mktemp)
          cat "$dev" > "$rxtmp" 2>/dev/null &
          local rx_pid=$!
          sleep 0.1

          # Send
          printf '%s\r\n' "$line" > "$dev"

          # Wait for data to loop back
          local found=0
          for i in $(seq 1 30); do
            if grep -qF "$line" "$rxtmp" 2>/dev/null; then found=1; break; fi
            sleep 0.1
          done

          kill $rx_pid 2>/dev/null
          wait $rx_pid 2>/dev/null

          local received=$(grep -F "$line" "$rxtmp" 2>/dev/null | head -1 | tr -dc '[:print:]')
          rm -f "$rxtmp"

          printf '\033[1;32mRX>\033[0m %s\n' "${received:-(nothing)}"
          printf '──────────────────────────────────\n'
          if [ -n "$received" ] && echo "$received" | grep -qF "$line"; then
            printf '  \033[1;32mOK\033[0m\n'
          else
            printf '  \033[1;31mMISMATCH\033[0m\n'
          fi
        done

        stty -F "$dev" sane 2>/dev/null
        printf '\nPress any key...'; read -r -n 1 dummy
        ;;
      5)
        # Crosstalk test between two ports
        local all_ports=$(ls /dev/ttyS* /dev/ttyAMA* /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ')
        local cross_menu=""
        for p in $all_ports; do
          local n=$(basename "$p")
          [ "$n" = "$port" ] && continue
          local lab="-"
          [ "$n" = "$console" ] && lab="[CONSOLE]"
          cross_menu="${cross_menu} ${n} ${lab}"
        done
        if [ -z "$cross_menu" ]; then
          whiptail --msgbox "No other serial port available for crosstalk test.\nNeed at least 2 ports." 10 60
          continue
        fi
        local port2
        port2=$(whiptail --title "Crosstalk Test" --menu \
          "Connect $port TX <-> target RX, $port RX <-> target TX\n\nSelect the SECOND port:" \
          16 65 8 --cancel-button Back ${cross_menu} 3>&1 1>&2 2>&3)
        local p2_ret=$?
        [ $p2_ret -ne 0 ] && continue
        [ -z "$port2" ] && continue
        local dev2="/dev/$port2"

        local baud=$(whiptail --inputbox "Baud rate for both ports:" 8 50 "115200" 3>&1 1>&2 2>&3)
        [ -z "$baud" ] && continue

        # Warn if either port is console
        if [ "$port" = "$console" ] || [ "$port2" = "$console" ]; then
          whiptail --yesno "One of the ports ($port/$port2) is the KERNEL CONSOLE.\n\
Console messages will interfere with test data.\n\nContinue anyway?" 12 60 || continue
        fi

        stty -F "$dev" "$baud" raw -echo min 0 time 2 2>/dev/null
        stty -F "$dev2" "$baud" raw -echo min 0 time 2 2>/dev/null
        local test_str="ROBOPI_XT_$(date +%s)"

        # Direction A->B: send from $dev, receive on $dev2
        local tmp2=$(mktemp)
        cat "$dev2" > "$tmp2" 2>/dev/null &
        local reader_pid=$!
        sleep 0.3
        printf '%s\r\n' "A2B:${test_str}" > "$dev" 2>/dev/null
        local found_ab=0
        for i in $(seq 1 20); do
          if grep -q "$test_str" "$tmp2" 2>/dev/null; then found_ab=1; break; fi
          sleep 0.1
        done
        kill $reader_pid 2>/dev/null; wait $reader_pid 2>/dev/null

        # Direction B->A: send from $dev2, receive on $dev
        local tmp1=$(mktemp)
        cat "$dev" > "$tmp1" 2>/dev/null &
        local reader_pid2=$!
        sleep 0.3
        printf '%s\r\n' "B2A:${test_str}" > "$dev2" 2>/dev/null
        local found_ba=0
        for i in $(seq 1 20); do
          if grep -q "$test_str" "$tmp1" 2>/dev/null; then found_ba=1; break; fi
          sleep 0.1
        done
        kill $reader_pid2 2>/dev/null; wait $reader_pid2 2>/dev/null

        local result_msg="Crosstalk Test @ ${baud}bps\n\n"
        result_msg="${result_msg}Wiring: $port TX <-> $port2 RX, $port RX <-> $port2 TX\n\n"

        if [ $found_ab -eq 1 ]; then
          result_msg="${result_msg}$port -> $port2 : PASS\n"
        else
          result_msg="${result_msg}$port -> $port2 : FAIL (no data)\n"
        fi
        if [ $found_ba -eq 1 ]; then
          result_msg="${result_msg}$port2 -> $port : PASS\n"
        else
          result_msg="${result_msg}$port2 -> $port : FAIL (no data)\n"
        fi
        result_msg="${result_msg}\nTest key: ${test_str}\n"

        if [ $found_ab -eq 1 ] && [ $found_ba -eq 1 ]; then
          result_msg="${result_msg}\nResult: FULL PASS - Both directions working!"
        elif [ $found_ab -eq 1 ] || [ $found_ba -eq 1 ]; then
          result_msg="${result_msg}\nResult: PARTIAL - Only one direction working.\nCheck wiring on the failing direction."
        else
          result_msg="${result_msg}\nResult: FAIL - No crosstalk in either direction.\nCheck wiring and baud rate."
        fi

        whiptail --title "Crosstalk: $port <-> $port2" --msgbox "$result_msg" 18 70
        rm -f "$tmp1" "$tmp2"
        ;;
    esac
  done
}

do_test_rs485() {
  # Only show ttyUSB* ports
  local ports=$(ls /dev/ttyUSB* 2>/dev/null | tr '\n' ' ')
  if [ -z "$ports" ]; then
    whiptail --msgbox "RS485: No USB serial ports found\n\n(ttyUSB* = RS485 adapter)" 8 50
    return
  fi

  local menu=""
  for p in $ports; do
    menu="${menu} $(basename $p) \"\""
  done
  local port
  port=$(whiptail --title "RS485 Test" --menu "Select RS485 port:" 14 50 8 \
    --cancel-button Back --ok-button Select ${menu} 3>&1 1>&2 2>&3)
  [ $? -ne 0 ] && return
  [ -z "$port" ] && return
  local dev="/dev/$port"

  # ── GPIO1A3 direction control ──
  local rs485_gpio=""
  if whiptail --yesno "Use GPIO1A3 for RS485 direction?\n\n\
HIGH = TX (drive bus)\n\
LOW  = RX (listen)\n\n\
Hardware: R412 removed, R177=1K, R178=0R" 13 60; then
    # Auto-detect GPIO1A3 (GPIO1 base=32, pin=3 → gpio35)
    for base in 32 512; do
      if [ -d "/sys/class/gpio/gpiochip${base}" ]; then
        rs485_gpio=$((base + 3))
        break
      fi
    done
    rs485_gpio=$(whiptail --inputbox "GPIO number for GPIO1A3:" 8 50 "${rs485_gpio:-35}" 3>&1 1>&2 2>&3)
    [ -z "$rs485_gpio" ] && return
    if ! [ -d "/sys/class/gpio/gpio${rs485_gpio}" ]; then
      echo "$rs485_gpio" > /sys/class/gpio/export 2>/dev/null
    fi
    if [ -d "/sys/class/gpio/gpio${rs485_gpio}" ]; then
      echo "out" > "/sys/class/gpio/gpio${rs485_gpio}/direction" 2>/dev/null
      echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null
    else
      whiptail --msgbox "Cannot access GPIO${rs485_gpio}" 8 50
      rs485_gpio=""
    fi
  fi

  # ── Mode ──
  local mode
  mode=$(whiptail --title "RS485 Test: $port" --menu \
    "Port: $dev\nGPIO: ${rs485_gpio:-none}\n\nRS485 is half-duplex.\nUse another device on the bus to test.\n\nSelect mode:" \
    16 65 3 --cancel-button Back \
    "TX" "Send data  (GPIO ↑ → TX → GPIO ↓)" \
    "RX" "Listen     (GPIO ↓, continuous cat)" \
    3>&1 1>&2 2>&3)
  [ $? -ne 0 ] && { [ -n "$rs485_gpio" ] && echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null; return; }

  local baud=$(whiptail --inputbox "Baud rate:" 8 50 "115200" 3>&1 1>&2 2>&3)
  [ -z "$baud" ] && { [ -n "$rs485_gpio" ] && echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null; return; }

  stty -F "$dev" "$baud" raw -echo min 0 time 1 2>/dev/null

  if [ "$mode" = "RX" ]; then
    # ══════════ RX: simple continuous cat ══════════
    [ -n "$rs485_gpio" ] && echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null

    clear
    printf '\033[1;35m══════ RS485 Listen ══════\033[0m\n'
    printf 'Port: %-10s  Baud: %-7s  GPIO%s: LOW (RX)\n' "$dev" "$baud" "${rs485_gpio:-?}"
    printf 'Waiting for data...  (Ctrl+C to stop)\n'
    printf '──────────────────────────────────\n'

    cat "$dev" 2>/dev/null | while IFS= read -r line; do
      printf '\033[1;32mRX>\033[0m %s\n' "$line"
    done
  else
    # ══════════ TX: GPIO↑ → dummy sync → send → GPIO↓ ══════════
    [ -n "$rs485_gpio" ] && echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null

    clear
    printf '\033[1;35m══════ RS485 Send ══════\033[0m\n'
    printf 'Port: %-10s  Baud: %-7s  GPIO%s: ↑(TX)→↓(RX)\n' "$dev" "$baud" "${rs485_gpio:-?}"
    printf 'Each send: GPIO↑ → sync → [real data] → GPIO↓\n'
    printf '\033[31mFirst line = throwaway (absorbs DE glitch)\033[0m\n'
    printf '──────────────────────────────────\n'

    while true; do
      printf '\033[1;33mTX>\033[0m '
      IFS= read -r line
      [ -z "$line" ] && { printf 'Done.\n'; break; }

      if [ -n "$rs485_gpio" ]; then
        # ↑ HIGH → TX mode, wait 50ms for MAX485 to stabilize
        echo "1" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null
        sleep 0.05
        # Send a dummy line first — absorbs DE switching noise
        printf 'SYNC\r\n' > "$dev"
        sleep "0.0$((${#line} + 2))"
      fi

      # Send the REAL data
      printf '%s\r\n' "$line" > "$dev"
      printf '  \033[2m→ %s\033[0m\n' "$line"

      if [ -n "$rs485_gpio" ]; then
        sleep "0.0$((${#line} + 2))"
        echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null
      fi
    done
  fi

  [ -n "$rs485_gpio" ] && echo "0" > "/sys/class/gpio/gpio${rs485_gpio}/value" 2>/dev/null
  stty -F "$dev" sane 2>/dev/null
  printf '\nPress any key...'; read -r -n 1 dummy
}

do_test_gpio() {
  clear
  printf '\033[1;33m══════ GPIO Info ══════\033[0m\n\n'
  printf '%-10s  %-5s  %-28s  %-4s  %-3s  %s\n' "Chip" "Pin" "Label" "Dir" "Val" "Flags"
  printf '%-10s  %-5s  %-28s  %-4s  %-3s  %s\n' "────────" "─────" "──────────────────────────" "────" "───" "─────"

  local raw
  [ -f /sys/kernel/debug/gpio ] && raw=$(cat /sys/kernel/debug/gpio 2>/dev/null)
  if [ -z "$raw" ]; then
    echo "(no GPIO debug info available)"
  else
    local chip=""
    while IFS= read -r line; do
      if echo "$line" | grep -q "^gpiochip"; then
        chip=$(echo "$line" | sed -n 's/.*\(gpiochip[0-9][0-9]*\).*/\1/p')
      fi
      if echo "$line" | grep -qE '^[[:space:]]*gpio-[0-9]'; then
        local num=$(echo "$line" | sed -n 's/.*gpio-\([0-9][0-9]*\).*/\1/p')
        local label=$(echo "$line" | sed 's/^[^(]*(//; s/|.*//; s/)$//' | xargs)
        local dir=""
        echo "$line" | grep -q '\bin\b' && dir="IN"
        echo "$line" | grep -q '\bout\b' && dir="OUT"
        local val=""
        echo "$line" | grep -q '\bhi\b' && val="HI"
        echo "$line" | grep -q '\blo\b' && val="LO"
        local flags=""
        echo "$line" | grep -q '\bIRQ\b' && flags="IRQ"
        echo "$line" | grep -q 'ACTIVE LOW' && flags="${flags} LO"
        printf '%-10s  %-5s  %-28s  %-4s  %-3s  %s\n' "${chip:-?}" "GPIO$num" "${label:0:28}" "${dir:--}" "${val:--}" "$flags"
      fi
    done <<< "$raw"
  fi

  printf '\nPress any key...'; read -r -n 1 dummy
}

do_test_hdmi() {
  local tmpfile=$(mktemp)
  for f in /sys/class/drm/card*-*/status; do
    if [ -f "$f" ]; then
      local conn=$(echo "$f" | sed 's|.*/\([^/]\+\)-[0-9]\+/status|\1|')
      local state=$(cat "$f" 2>/dev/null)
      echo "${conn}: ${state}" >> "$tmpfile"
    fi
  done
  [ ! -s "$tmpfile" ] && echo "No DRM connectors found" > "$tmpfile"
  whiptail --textbox "$tmpfile" 16 70 --scrolltext
  rm -f "$tmpfile"
}

#
# Interactive use loop
#
if [ "$INTERACTIVE" = True ]; then
  calc_wt_size
  while [ "$USER" = "root" ] || [ -z "$USER" ]; do
    if ! USER=$(whiptail --inputbox "robopi-config could not determine the default user.\\n\\nWhat user should these settings apply to?" 20 60 root 3>&1 1>&2 2>&3); then
      return 0
    fi
  done
  while true; do
    BOARD_MODEL=$(cat /proc/device-tree/model 2>/dev/null | tr '\0' '\n' | sed 's/Orange Pi/RoboPi2/g' || echo "RoboParty Board")
    FUN=$(whiptail --title "RoboParty Configuration Tool (robopi-config)" --backtitle "${BOARD_MODEL}" --menu "Setup Options" $WT_HEIGHT $WT_WIDTH $WT_MENU_HEIGHT --cancel-button Exit --ok-button Select \
      "1 System Options" "Configure system settings" \
      "2 Display Options" "Configure display settings" \
      "3 Interface Options" "Configure connections to peripherals" \
      "5 Localisation Options" "Configure language and regional settings" \
      "6 Advanced Options" "Configure advanced settings" \
      "7 Hardware Test" "Test WiFi, Ethernet, USB, CAN, Serial, GPIO, HDMI" \
      "8 Update" "Update this tool to the latest version" \
      "9 About robopi-config" "Information about this configuration tool" \
      3>&1 1>&2 2>&3)
    RET=$?
    if [ $RET -eq 1 ]; then
      do_finish
    elif [ $RET -eq 0 ]; then
      case "$FUN" in
        1\ *) do_system_menu ;;
        2\ *) do_display_menu ;;
        3\ *) do_interface_menu ;;
        4\ *) do_performance_menu ;;
        5\ *) do_internationalisation_menu ;;
        6\ *) do_advanced_menu ;;
        7\ *) do_hwtest_menu ;;
        8\ *) do_update ;;
        9\ *) do_about ;;
        *) whiptail --msgbox "Programmer error: unrecognized option" 20 60 1 ;;
      esac || whiptail --msgbox "There was an error running option $FUN" 20 60 1
    else
      exit 1
    fi
  done
fi
