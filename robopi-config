do_test_usb_can() {
  local can_ifs=$(ip link show 2>/dev/null | sed -n 's/^[0-9]*: \([^:@]*\).*/\1/p' | grep -E '^can' | sort -u)
  local gs_usb=$(lsusb 2>/dev/null | grep -i "gs_usb\|cantact\|canable\|slcan\|gs_can" || echo "")

  local msg="USB CAN Test\n\n"

  # USB adapter check
  if [ -n "$gs_usb" ]; then
    msg="${msg}USB CAN adapter: DETECTED\n\n"
  elif ls /dev/ttyUSB* >/dev/null 2>&1 || ls /dev/slcan* >/dev/null 2>&1; then
    msg="${msg}USB CAN adapter: DETECTED (via serial)\n\n"
  elif lsusb 2>/dev/null | grep -q "gs_usb\|gs_can"; then
    msg="${msg}USB CAN adapter: DETECTED\n\n"
  else
    msg="${msg}USB CAN adapter: found by driver only\n\n"
  fi

  # CAN interfaces status
  if [ -n "$can_ifs" ]; then
    local count=$(echo "$can_ifs" | wc -l)
    msg="${msg}CAN interfaces: ${count} found\n\n"
    for iface in $can_ifs; do
      local st=$(ip link show "$iface" 2>/dev/null | sed -n 's/.*state \([A-Za-z]*\).*/\1/p')
      if [ "$st" = "UP" ]; then
        msg="${msg}  ${iface}: OK (UP)\n"
      else
        msg="${msg}  ${iface}: DOWN\n"
      fi
    done
  else
    msg="${msg}CAN interfaces: NONE\n\n(sudo ip link set can0 up type can bitrate 500000)\n"
  fi

  whiptail --msgbox "$msg" 18 65
}

