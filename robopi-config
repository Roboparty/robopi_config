        $PREFIX systemctl --user -q start rpi-connect.service
      else
        $PREFIX rpi-connect on > /dev/null 2>&1
      fi
      STATUS="Screen sharing via Raspberry Pi Connect is enabled"
    else
      return 1
    fi
  elif [ $RET -eq 1 ]; then
    if [ "$INTERACTIVE" = True ]; then
      whiptail --yesno "Would you like to enable remote shell access over Raspberry Pi Connect?" --defaultno 20 60 2
      RET=$?
    fi
    if [ $RET -eq 0 ]; then
      if is_installed rpi-connect || is_installed rpi-connect-lite || apt-get install "$APT_GET_FLAGS" rpi-connect-lite; then
        if dpkg --compare-versions "$rpi_connect_version" lt 2.0; then
          $PREFIX systemctl --user -q enable rpi-connect.service
          $PREFIX systemctl --user -q start rpi-connect.service
        else
          $PREFIX rpi-connect on > /dev/null 2>&1
        fi
        STATUS="Remote shell access via Raspberry Pi Connect is enabled"
      else
        return 1
      fi
    elif [ $RET -eq 1 ]; then
      if dpkg --compare-versions "$rpi_connect_version" lt 1.3; then
        $PREFIX systemctl --user -q stop rpi-connect.service rpi-connect-wayvnc.service
        $PREFIX systemctl --user -q disable rpi-connect-wayvnc.service rpi-connect.service
      elif dpkg --compare-versions "$rpi_connect_version" lt 2.0; then
        $PREFIX systemctl --user -q stop rpi-connect.service
        $PREFIX systemctl --user -q disable rpi-connect.service rpi-connect-wayvnc.service rpi-connect-wayvnc-watcher.path
      else
        $PREFIX rpi-connect off > /dev/null 2>&1
      fi
      STATUS="Raspberry Pi Connect is disabled"
    else
      return $RET
    fi
  else
    return $RET
  fi
  if [ "$INTERACTIVE" = True ]; then
    whiptail --msgbox "$STATUS" 20 60 1
  fi
}

# ===== RoboParty Hardware Overlay Checklist =====
# Opens a checklist of ALL available device tree overlays,
# similar to orangepi-config's Hardware toggle interface.

do_hardware_overlays() {
  if [ -z "$OVERLAYDIR" ] || [ ! -d "$OVERLAYDIR" ]; then
    whiptail --msgbox "No device tree overlay directory found.\n\nOverlay directory: ${OVERLAYDIR:-not set}\n\nBoot config: ${CONFIG}" 12 70
    return 0
  fi

  # Read overlay prefix from boot config (e.g. overlay_prefix=rk3588)
  local overlay_prefix=""
  if [ -f "$CONFIG" ]; then
    overlay_prefix=$(get_config_var overlay_prefix "$CONFIG" 2>/dev/null)
    [ "$overlay_prefix" = "0" ] && overlay_prefix=""
  fi

  # Find .dtbo files matching the prefix
  local dtbo_list=""
  if [ -n "$overlay_prefix" ]; then
    dtbo_list=$(ls -1 ${OVERLAYDIR}/${overlay_prefix}*.dtbo 2>/dev/null)
  fi
  # Fallback: grab all .dtbo if no prefix-matched ones found
  if [ -z "$dtbo_list" ]; then
    dtbo_list=$(ls -1 ${OVERLAYDIR}/*.dtbo 2>/dev/null)
    overlay_prefix=""
  fi

  if [ -z "$dtbo_list" ]; then
    whiptail --msgbox "No .dtbo overlay files found in:\n\n  ${OVERLAYDIR}" 10 70
    return 0
  fi

  # Build checklist items for whiptail
  local checklist_items=()
  local j=0

  while IFS= read -r dtbo_file; do
    local filename=$(basename "$dtbo_file" .dtbo)
    local display_name="$filename"

    # Strip prefix for cleaner display (e.g. rk3588-spi-spidev → spi-spidev)
    if [ -n "$overlay_prefix" ]; then
      display_name="${filename#$overlay_prefix}"
      display_name="${display_name#-}"
      display_name="${display_name#_}"
    fi

    # Determine current on/off state
    local state="OFF"
    if has_overlay "$display_name"; then
      state="ON"
    fi

    checklist_items+=("$display_name" "" "$state")
    j=$((j + 1))
  done < <(echo "$dtbo_list")

  local num_items=$j
  local list_height=$((num_items + 9))
  [ $list_height -gt 30 ] && list_height=30
  [ $list_height -lt 10 ] && list_height=10
  local menu_height=$((num_items + 2))
  [ $menu_height -gt 20 ] && menu_height=20

  # ===== Show the checklist =====
  local selection
  selection=$(whiptail --title "Hardware Overlay Configuration" \
    --checklist "Use SPACE to toggle, ENTER to save, ESC to cancel.\n\nOverlay directory: ${OVERLAYDIR}" \
    $list_height 85 $menu_height \
    "${checklist_items[@]}" \
    3>&1 1>&2 2>&3)
  local ret=$?

  if [ $ret -ne 0 ]; then
    return 0  # User cancelled or pressed ESC
  fi

  # Parse whiptail checklist output: "item1" "item2" → item1 item2
  local newoverlays=$(echo "$selection" | tr -d '"' | xargs)

  # Update overlays= line in boot config
  if [ -n "$newoverlays" ]; then
    if grep -q "^overlays=" "$CONFIG"; then
      sed -i "s/^overlays=.*/overlays=$newoverlays/" "$CONFIG"
    else
      echo "overlays=$newoverlays" >> "$CONFIG"
    fi
  else
    # All disabled → remove overlays= line
    if grep -q "^overlays=" "$CONFIG"; then
      sed -i "/^overlays=/d" "$CONFIG"
    fi
  fi

  ASK_TO_REBOOT=1
  whiptail --msgbox "Hardware overlay configuration saved.\n\nCurrent overlays: ${newoverlays:-(none)}\n\nA reboot is required for changes to take effect." 12 70
}

get_spi() {
  # Check for device tree overlay first
  local spi_overlay=$(ls ${OVERLAYDIR}/spi*.dtbo 2>/dev/null | head -1)
  if [ -n "$spi_overlay" ]; then
    local name=$(get_overlay_name "$spi_overlay")
    if has_overlay "$name"; then
      echo 0  # enabled via overlay
    else
      echo 1  # disabled
    fi
  else
    # Fallback: check kernel module (spidev)
    if lsmod 2>/dev/null | grep -q "^spidev"; then
      echo 0
    elif grep -q "^spidev" /etc/modules 2>/dev/null; then
      echo 0
    else
      echo 1
    fi
  fi
}

do_spi() {
  DEFAULT=--defaultno
  if [ $(get_spi) -eq 0 ]; then
    DEFAULT=
  fi
  if [ "$INTERACTIVE" = True ]; then
    whiptail --yesno "Would you like the SPI interface to be enabled?" $DEFAULT 20 60 2
    RET=$?
  else
    RET=$1
  fi
  if [ $RET -eq 0 ]; then
    STATUS=enabled
  elif [ $RET -eq 1 ]; then
    STATUS=disabled
  else
    return $RET
  fi

  local spi_overlay=$(ls ${OVERLAYDIR}/spi*.dtbo 2>/dev/null | head -1)
  if [ -n "$spi_overlay" ]; then
    # Overlay-based management
    local name=$(get_overlay_name "$spi_overlay")
    if [ "$STATUS" = "enabled" ]; then
      add_overlay "$name"
      ASK_TO_REBOOT=1
    else
      remove_overlay "$name"
      ASK_TO_REBOOT=1
    fi
  else
    # Module-based management (no overlay available)
    if [ "$STATUS" = "enabled" ]; then
      if ! [ -e $BLACKLIST ]; then
        touch $BLACKLIST
      fi
      sed $BLACKLIST -i -e "s/^\(blacklist[[:space:]]*spidev\)/#\1/"
      modprobe spidev 2>/dev/null || true
      if ! grep -q "^spidev" /etc/modules 2>/dev/null; then
        echo "spidev" >> /etc/modules
      fi
    else
      modprobe -r spidev 2>/dev/null || true
      sed -i "/^spidev/d" /etc/modules 2>/dev/null || true
    fi
  fi

  if [ "$INTERACTIVE" = True ]; then
    if [ -n "$spi_overlay" ]; then
      whiptail --msgbox "The SPI interface is $STATUS\n\nA reboot is required for the change to take effect." 20 60 1
    else
      whiptail --msgbox "The SPI interface is $STATUS" 20 60 1
    fi
  fi
}

get_i2c() {
