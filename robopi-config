get_sudo_pass() {
  if sudo -l -n -U $USER 2> /dev/null | grep -q "(ALL) NOPASSWD: ALL" 2> /dev/null ; then
    echo 1
  else
    echo 0
  fi
}

do_sudo_pass() {
  PSFILE="/etc/sudoers.d/010_$USER-nopasswd"
  GPSFILE="/etc/sudoers.d/010_pi-nopasswd"
  CIFILE="/etc/sudoers.d/90-cloud-init-users"
  DEFAULT=--defaultno
  if [ "$(get_sudo_pass)" -eq 0 ]; then
    DEFAULT=
  fi
  if [ "$INTERACTIVE" = True ]; then
    whiptail --yesno \
      "Would you like the admin (sudo) password to be enabled?" \
      $DEFAULT 20 60 2
    RET=$?
  else
    RET=$1
  fi
  if [ "$RET" -eq 0 ]; then
    if [ -e $PSFILE ] ; then rm $PSFILE ; fi
    if [ -e $GPSFILE ] ; then rm $GPSFILE ; fi
    if [ -e $CIFILE ] ; then rm $CIFILE ; fi
    STATUS=enabled
  elif [ "$RET" -eq 1 ]; then
    if [ -e $GPSFILE ] ; then rm $GPSFILE ; fi
    if [ -e $CIFILE ] ; then rm $CIFILE ; fi
      cat > $PSFILE << EOF
$USER ALL=(ALL) NOPASSWD: ALL
EOF
    STATUS=disabled
  else
    return "$RET"
  fi
  if [ "$INTERACTIVE" = True ]; then
    whiptail --msgbox "The admin password is $STATUS" 20 60 1
  fi
}

