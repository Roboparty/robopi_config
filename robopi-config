# ===== RoboParty Hardware Configuration Functions =====

do_cpu_config() {
  local govs="/sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors"
  local cur_gov=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo "unknown")
  local cur_min=$(($(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq 2>/dev/null || echo 0) / 1000))
  local cur_max=$(($(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 2>/dev/null || echo 0) / 1000))

  local gov_list=""
  [ -f "$govs" ] && gov_list=$(cat "$govs")

  local choice
  choice=$(whiptail --title "CPU Configuration" --menu \
    "Current: ${cur_gov}  |  Min: ${cur_min}MHz  |  Max: ${cur_max}MHz\n\nSelect action:" \
    14 65 3 --cancel-button Back --ok-button Select \
    "1" "Change CPU governor" \
    "2" "Set CPU frequency limits" \
    "3" "Show CPU info" \
    3>&1 1>&2 2>&3)
  if [ $? -ne 0 ] || [ -z "$choice" ]; then
    return 0
  fi

  case "$choice" in
    1)
      if [ -z "$gov_list" ]; then
        whiptail --msgbox "Cannot read available governors" 8 50
        return 0
      fi
      local items=""
      local gov_count=0
      for g in $gov_list; do
        items="${items} ${g} ."
        gov_count=$((gov_count + 1))
      done
      local gov_height=$((gov_count + 4))
      [ $gov_height -gt 14 ] && gov_height=14
      [ $gov_height -lt 8 ] && gov_height=8
      local NEWGOV
      NEWGOV=$(whiptail --title "Select Governor" --menu "Choose:" $gov_height 50 $gov_count ${items} 3>&1 1>&2 2>&3)
      if [ -n "$NEWGOV" ]; then
        echo "$NEWGOV" | tee /sys/devices/system/cpu/cpufreq/policy0/scaling_governor >/dev/null 2>&1
        whiptail --msgbox "Governor set to $NEWGOV" 8 40
      fi
      ;;
    2)
      local NEWMIN NEWMAX
      NEWMIN=$(whiptail --inputbox "Min frequency (MHz):" 8 50 "$cur_min" 3>&1 1>&2 2>&3)
      NEWMAX=$(whiptail --inputbox "Max frequency (MHz):" 8 50 "$cur_max" 3>&1 1>&2 2>&3)
      [ -n "$NEWMIN" ] && echo $(($NEWMIN * 1000)) | tee /sys/devices/system/cpu/cpufreq/policy0/scaling_min_freq >/dev/null 2>&1
      [ -n "$NEWMAX" ] && echo $(($NEWMAX * 1000)) | tee /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq >/dev/null 2>&1
      whiptail --msgbox "CPU freq limits updated" 8 40
      ;;
    3)
      local info=""
      info="${info}Model: $(cat /proc/device-tree/model 2>/dev/null | tr '\0' ' ' || echo 'unknown')\n"
      info="${info}Cores: $(grep -c processor /proc/cpuinfo)\n"
      info="${info}Governor: $(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor)\n"
      for p in /sys/devices/system/cpu/cpufreq/policy*; do
        local cpu=$(basename $p)
        local min=$(($(cat $p/scaling_min_freq 2>/dev/null || echo 0) / 1000))
        local max=$(($(cat $p/scaling_max_freq 2>/dev/null || echo 0) / 1000))
        local gov=$(cat $p/scaling_governor 2>/dev/null || echo unknown)
        info="${info}\n${cpu}: ${gov} ${min}-${max}MHz"
      done
      whiptail --msgbox "$info" 18 60
      ;;
  esac
}

do_ssh_config() {
