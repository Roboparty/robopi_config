#
# Hardware Test Functions
#
# ===== Serial Port Settings Formatter =====
# Parses raw stty -a output into a clean, readable display

format_stty() {
  local dev="$1"
  local raw
  raw=$(stty -F "$dev" -a 2>/dev/null) || { printf '%s\n' "Cannot read $dev"; return 1; }

  local speed; speed=$(echo "$raw" | sed -n 's/.*speed \([0-9][0-9]*\).*/\1/p')
  local cs;    cs=$(echo "$raw" | sed -n 's/.*\(cs[0-9][0-9]*\).*/\1/p')
  local parenb; parenb=$(echo "$raw" | awk '{for(i=1;i<=NF;i++) if($i ~ /^-?parenb$/) print $i}')
  local cstopb; cstopb=$(echo "$raw" | awk '{for(i=1;i<=NF;i++) if($i ~ /^-?cstopb$/) print $i}')
  local crtscts;crtscts=$(echo "$raw" | awk '{for(i=1;i<=NF;i++) if($i ~ /^-?crtscts$/) print $i}')

  _onoff() { case "$1" in -*) echo "OFF";; *) echo "ON";; esac; }

  printf '%s\n' \
    "══════ Serial Port Settings ══════" \
    "" \
    "  Port:      ${dev}" \
    "  Speed:     ${speed} baud" \
    "  Data:      ${cs#cs}bit        Stop bits: $(_onoff "$cstopb")" \
    "  Parity:    $(_onoff "$parenb")       Flow ctrl: $(_onoff "$crtscts")" \
    "" \
    "────"
}

