_ping_monitor() {
  local label="$1" iface="$2" ip="$3"
  local targets="www.roboparty.com www.baidu.com 8.8.8.8"

  clear
  printf '\033[1;36m=== %s Ping Monitor ===\033[0m\n' "$label"
  printf 'Interface: %s   IP: %s\n' "$iface" "$ip"
  printf '\033[2mPress ENTER to stop and return to menu\033[0m\n\n'
  printf '%-28s %-8s %s\n' "Target" "Status" "Latency"
  printf '%-28s %-8s %s\n' "--------------------------" "------" "-------"

  local tmpfile=$(mktemp)

  # Background ping loop
  (
    local round=0
    while true; do
      round=$((round + 1))
      printf "\n\033[33m[Round %d @ %s]\033[0m\n" "$round" "$(date +%H:%M:%S)" >> "$tmpfile"
      for t in $targets; do
        local r=$(ping -I "$iface" -c 1 -W 2 "$t" 2>/dev/null | sed -n 's/.*time=\([0-9.]*\).*/\1/p' 2>/dev/null)
        local name="$t"
        [ "$t" = "8.8.8.8" ] && name="8.8.8.8(internet)"
        if [ -n "$r" ]; then
          printf "  %-26s \033[1;32m%-8s\033[0m %sms\n" "$name" "OK" "$r" >> "$tmpfile"
        else
          printf "  %-26s \033[1;31m%-8s\033[0m -\n" "$name" "FAIL" >> "$tmpfile"
        fi
      done
      sleep 1
    done
  ) &
  local bg_pid=$!

  trap "kill $bg_pid 2>/dev/null; wait $bg_pid 2>/dev/null; rm -f '$tmpfile'" INT

  # Display loop: show new lines, check for Enter every 0.3s
  local shown=0
  while kill -0 $bg_pid 2>/dev/null; do
    local cur=$(stat -c%s "$tmpfile" 2>/dev/null || echo 0)
    if [ "$cur" -gt "$shown" ]; then
      dd if="$tmpfile" bs=1 skip="$shown" count=$((cur - shown)) 2>/dev/null
      shown=$cur
    fi
    # Non-blocking read with 0.3s timeout
    if read -t 0.3 -r dummy; then
      break
    fi
  done

  kill $bg_pid 2>/dev/null
  wait $bg_pid 2>/dev/null
  rm -f "$tmpfile"
  trap - INT

  printf '\n\n\033[1;32mPing monitor stopped. Returning to menu...\033[0m\n'
  sleep 1
}

