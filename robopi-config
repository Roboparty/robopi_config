do_can_config() {
  local can_ifaces=$(ip link show 2>/dev/null | sed -n 's/^[0-9]*: \([^:@]*\).*/\1/p' | grep -E '^can' | sort -u)
  if [ -z "$can_ifaces" ]; then
    whiptail --msgbox "No CAN interfaces found.\n\nCheck: ip link show" 10 50
    return
  fi
  while true; do
    local menu_items=""
    for c in $can_ifaces; do
      local st=$(ip link show "$c" 2>/dev/null | sed -n 's/.*state \([A-Za-z]*\).*/\1/p')
      local bits=$(ip -d link show "$c" 2>/dev/null | sed -n 's/.*bitrate \([0-9]*\).*/\1/p')
      menu_items="${menu_items} ${c} \"${st:-down}  ${bits:+${bits}bps}\""
    done
    FUN=$(whiptail --title "CAN Bus Configuration" --menu "Select CAN interface:" 16 60 10 \
      --cancel-button Back --ok-button Select \
      ${menu_items} \
      3>&1 1>&2 2>&3)
    RET=$?
    [ $RET -ne 0 ] && return 0
    [ -z "$FUN" ] && continue
    local state=$(ip link show "$FUN" 2>/dev/null | sed -n 's/.*state \([A-Za-z]*\).*/\1/p')
    local action_menu=""
    if [ "$state" = "UP" ]; then
      action_menu="down \"Bring interface DOWN\""
    else
      action_menu="up \"Bring interface UP\""
    fi
    action_menu="${action_menu} bitrate \"Set bitrate\" restart \"Restart interface\" info \"Show details\""
    ACT=$(whiptail --title "$FUN" --menu "Action:" 12 60 4 ${action_menu} 3>&1 1>&2 2>&3)
    [ $? -ne 0 ] && continue
    case "$ACT" in
      up)
        ip link set "$FUN" up && whiptail --msgbox "$FUN: UP" 8 40
        ;;
      down)
        ip link set "$FUN" down && whiptail --msgbox "$FUN: DOWN" 8 40
        ;;
      bitrate)
        local cur_bits=$(ip -d link show "$FUN" 2>/dev/null | sed -n 's/.*bitrate \([0-9]*\).*/\1/p' || echo "500000")
        NEWBITS=$(whiptail --inputbox "Bitrate for $FUN:" 8 50 "$cur_bits" 3>&1 1>&2 2>&3)
        [ -n "$NEWBITS" ] && ip link set "$FUN" down 2>/dev/null; ip link set "$FUN" type can bitrate "$NEWBITS" 2>/dev/null; ip link set "$FUN" up 2>/dev/null && \
          whiptail --msgbox "$FUN: bitrate set to ${NEWBITS}bps" 8 50
        ;;
      restart)
        ip link set "$FUN" down 2>/dev/null; sleep 0.2; ip link set "$FUN" up 2>/dev/null && \
          whiptail --msgbox "$FUN: restarted" 8 40
        ;;
      info)
        local det=$(ip -d link show "$FUN" 2>/dev/null)
        whiptail --msgbox "$det" 20 70
        ;;
    esac
  done
}

do_serial_robopi() {
  local ports=$(ls /dev/ttyS* /dev/ttyAMA* /dev/ttyUSB* 2>/dev/null | tr '\n' ' ')
  if [ -z "$ports" ]; then
    whiptail --msgbox "No serial ports found.\n\nCheck: ls /dev/ttyS* /dev/ttyAMA*" 10 60
    return
  fi
  while true; do
    local menu_items=""
    for p in $ports; do
      local name=$(basename $p)
      local enabled="disabled"
      systemctl -q is-active serial-getty@${name}.service 2>/dev/null && enabled="enabled"
      menu_items="${menu_items} ${name} ${enabled}"
    done
    FUN=$(whiptail --title "Serial Port Configuration" --menu "Select port:" 14 60 8 \
      --cancel-button Back --ok-button Select ${menu_items} 3>&1 1>&2 2>&3)
    RET=$?
    [ $RET -ne 0 ] && return 0
    [ -z "$FUN" ] && continue
    local svc="serial-getty@${FUN}.service"
    if systemctl -q is-active "$svc" 2>/dev/null; then
      whiptail --yesno "$FUN: Serial console is ENABLED.\n\nDisable?" 10 50 || continue
      systemctl disable "$svc" 2>/dev/null
      systemctl stop "$svc" 2>/dev/null
      whiptail --msgbox "$FUN: serial console disabled" 8 50
    else
      whiptail --yesno "$FUN: Serial console is DISABLED.\n\nEnable getty on this port?" 10 50 || continue
      systemctl enable "serial-getty@${FUN}.service" 2>/dev/null
      systemctl start "serial-getty@${FUN}.service" 2>/dev/null
      whiptail --msgbox "$FUN: serial console enabled" 8 50
    fi
  done
}

do_rs485_config() {
  local ports=$(ls /dev/ttyUSB* 2>/dev/null | tr '\n' ' ')

  if [ -z "$ports" ]; then
    whiptail --msgbox "No RS485 ports found.\n\nCheck: ls /dev/ttyUSB*" 8 50
    return
  fi

  # Build port selection menu
  local menu_items=""
  for p in $ports; do
    local name=$(basename "$p")
    menu_items="${menu_items} ${name} \"\""
  done

  local choice
  choice=$(whiptail --title "RS485 Configuration" --menu \
    "Select RS485 port:" 14 60 8 --cancel-button Back --ok-button Select \
    ${menu_items} 3>&1 1>&2 2>&3)
  local choice_ret=$?
  [ $choice_ret -ne 0 ] && return
  [ -z "$choice" ] && return

  local port="/dev/${choice}"

  # ── GPIO direction control config ──
  local gpio_num=""
  if whiptail --yesno "Enable GPIO direction control for RS485?\n\n\
GPIO1A3 → RE/DE pin (R412 removed, R177=1K, R178=0R)\n\n\
TX mode: GPIO HIGH → drives the bus\n\
RX mode: GPIO LOW  → listens on the bus" 13 65; then
    # Auto-detect GPIO1A3
    for base in 32 512; do
      if [ -d "/sys/class/gpio/gpiochip${base}" ]; then
        gpio_num=$((base + 3))
        break
      fi
    done
    gpio_num=$(whiptail --inputbox "GPIO number for GPIO1A3:" 8 50 "${gpio_num:-35}" 3>&1 1>&2 2>&3)
    [ -z "$gpio_num" ] && return
    # Export
    if ! [ -d "/sys/class/gpio/gpio${gpio_num}" ]; then
      echo "$gpio_num" > /sys/class/gpio/export 2>/dev/null
      sleep 0.1
    fi
    if [ -d "/sys/class/gpio/gpio${gpio_num}" ]; then
      echo "out" > "/sys/class/gpio/gpio${gpio_num}/direction" 2>/dev/null
      echo "0" > "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null
      whiptail --msgbox "GPIO${gpio_num} ready (GPIO1A3)\nCurrent: LOW = RX mode" 8 50
    else
      whiptail --msgbox "Cannot access GPIO${gpio_num}" 8 50
      gpio_num=""
    fi
  fi

  # ── Action menu ──
  while true; do
    local port_info=$(stty -F "$port" 2>/dev/null | head -1 || echo "Cannot read $port")
    local gpio_status="none"
    [ -n "$gpio_num" ] && gpio_status="GPIO${gpio_num} ($(cat /sys/class/gpio/gpio${gpio_num}/value 2>/dev/null || echo '?')=RX)"

    FUN=$(whiptail --title "RS485: $choice" --menu \
      "Port: $port\nCurrent: $port_info\nGPIO dir: ${gpio_status}\n\nSelect action:" \
      16 70 6 --cancel-button Back --ok-button Select \
      "R1" "View port settings (stty)" \
      "R2" "Set baud rate" \
      "R3" "Send test data (GPIO ↑ → TX → GPIO ↓)" \
      "R4" "Listen/receive data (GPIO ↓)" \
      3>&1 1>&2 2>&3)
    RET=$?
    [ $RET -ne 0 ] && { [ -n "$gpio_num" ] && echo "0" > "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null; return 0; }

    case "$FUN" in
      R1\ *)
        local info=$(format_stty "$port")
        whiptail --msgbox "$info" 22 72
        ;;
      R2\ *)
        local rates="1200 2400 4800 9600 19200 38400 57600 115200 230400 460800 921600 1500000"
        local rate_items=""
        for r in $rates; do
          rate_items="${rate_items} ${r} \"bps\""
        done
        local baud=$(whiptail --title "Set Baud Rate" --menu "Choose:" 16 50 8 ${rate_items} 3>&1 1>&2 2>&3)
        [ -n "$baud" ] && stty -F "$port" "$baud" raw -echo 2>/dev/null && \
          whiptail --msgbox "Set $port to ${baud}bps raw -echo" 8 50
        ;;
      R3\ *)
        local msg=$(whiptail --inputbox "Data to send via $port:" 8 60 "Hello RS485" 3>&1 1>&2 2>&3)
        [ -z "$msg" ] && continue
        # GPIO HIGH → wait 20ms → send → wait drain → GPIO LOW
        [ -n "$gpio_num" ] && echo "1" > "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null && sleep 0.02
        printf '%s\r\n' "$msg" > "$port"
        sleep "0.0$((${#msg} + 2))"
        [ -n "$gpio_num" ] && echo "0" > "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null
        whiptail --msgbox "Sent: ${msg}\n\n$( [ -n "$gpio_num" ] && echo "GPIO${gpio_num}: ↑→TX→↓ (back to RX)")" 10 55
        ;;
      R4\ *)
        # GPIO LOW → RX
        [ -n "$gpio_num" ] && echo "0" > "/sys/class/gpio/gpio${gpio_num}/value" 2>/dev/null
        local timeout_s=$(whiptail --inputbox "Listen timeout (seconds):" 8 50 "5" 3>&1 1>&2 2>&3)
        [ -z "$timeout_s" ] && continue
        local tmp=$(mktemp)
        timeout "$timeout_s" cat "$port" > "$tmp" 2>/dev/null &
        local pid=$!
        { for ((i=0; i<=100; i+=20)); do sleep $(($timeout_s / 5)); echo $i; done } | \
          whiptail --gauge "Listening on $port for ${timeout_s}s...  GPIO${gpio_num:-?}=LOW(RX)" 8 60 0
        wait $pid 2>/dev/null
        local data=$(cat "$tmp" 2>/dev/null | tr -dc '[:print:]\n')
        [ -n "$data" ] && data="$data" || data="(no data received)"
        whiptail --msgbox "Received:\n${data}" 16 70
        rm -f "$tmp"
        ;;
    esac
  done
}

do_adb_config() {
  local adbd_running="no"
  pgrep -x "adbd" >/dev/null 2>&1 && adbd_running="yes"

  local usb_mode="unknown"
  if ls /sys/class/udc/*/state >/dev/null 2>&1; then
    usb_mode=$(cat /sys/class/udc/*/state 2>/dev/null | head -1)
  fi

  FUN=$(whiptail --title "ADB Configuration" --menu \
    "RoboParty = ADB device (like Android phone)\nWindows  = ADB host (adb.exe / RKDevTool)\n\n\
ADB daemon: ${adbd_running}\n\
USB gadget: ${usb_mode:-unknown}\n\n\
Select action:" \
    18 70 5 --cancel-button Back --ok-button Select \
    "A1" "Enable ADB  (set_device.sh + start adbd)" \
    "A2" "Disable ADB (stop adbd)" \
    "A3" "ADB status (ps + USB gadget state)" \
    3>&1 1>&2 2>&3)
  RET=$?
  [ $RET -ne 0 ] && return 0

  case "$FUN" in
    A1\ *)
      if [ -f /usr/local/bin/set_device.sh ]; then
        sudo /usr/local/bin/set_device.sh 2>/dev/null
      elif [ -f /usr/bin/set_device.sh ]; then
        sudo /usr/bin/set_device.sh 2>/dev/null
      else
        whiptail --msgbox "set_device.sh not found.\nUSB gadget mode may not be configured." 8 60
      fi
      if ! pgrep -x "adbd" >/dev/null 2>&1; then
        adbd 2>/dev/null &
        sleep 1
      fi
      if pgrep -x "adbd" >/dev/null 2>&1; then
        whiptail --msgbox "ADB enabled.\n\nOn Windows PC run:\n  adb devices\n  adb push <file> /home/orangepi/" 12 60
      else
        whiptail --msgbox "ADB failed to start.\n\nCheck: sudo set_device.sh" 10 50
      fi
      ;;
    A2\ *)
      killall adbd 2>/dev/null
      sleep 0.5
      if ! pgrep -x "adbd" >/dev/null 2>&1; then
        whiptail --msgbox "ADB stopped." 8 40
      else
        killall -9 adbd 2>/dev/null
        whiptail --msgbox "ADB force stopped." 8 40
      fi
      ;;
    A3\ *)
      local info=""
      info+="ADB daemon (adbd):\n"
      if pgrep -x "adbd" >/dev/null 2>&1; then
        info+="  $(ps -ax 2>/dev/null | grep adbd | grep -v grep)\n"
      else
        info+="  NOT RUNNING\n"
      fi
      info+="\nUSB Gadget state:\n"
      for f in /sys/class/udc/*/state; do
        [ -f "$f" ] && info+="  $f: $(cat "$f" 2>/dev/null)\n"
      done 2>/dev/null
      info+="\nOn Windows PC:\n  adb devices\n  adb push <file> /home/orangepi/\n  adb shell\n"
      whiptail --msgbox "$info" 18 70
      ;;
  esac
}

do_gpio_config() {
  local tmpfile=$(mktemp)
  local raw=""
  [ -f /sys/kernel/debug/gpio ] && raw=$(cat /sys/kernel/debug/gpio 2>/dev/null)
  [ -z "$raw" ] && command -v gpioinfo >/dev/null 2>&1 && raw=$(gpioinfo 2>/dev/null)

  if [ -z "$raw" ]; then
    echo "No GPIO info available." > "$tmpfile"
  else
    {
      echo "══════ GPIO Info ══════"
      echo ""
      printf "%-10s  %-5s  %-28s  %-4s  %-3s  %s\n" "Chip" "Pin" "Label" "Dir" "Val" "Flags"
      printf "%-10s  %-5s  %-28s  %-4s  %-3s  %s\n" "────────" "─────" "──────────────────────────" "────" "───" "─────"
      local chip=""
      while IFS= read -r line; do
        if echo "$line" | grep -q "^gpiochip"; then
          chip=$(echo "$line" | sed -n 's/.*\(gpiochip[0-9][0-9]*\).*/\1/p')
        fi
        if echo "$line" | grep -qE '^[[:space:]]*gpio-[0-9]'; then
          local num=$(echo "$line" | sed -n 's/.*gpio-\([0-9][0-9]*\).*/\1/p')
          local label=$(echo "$line" | sed 's/^[^(]*(//; s/).*//' | awk -F'|' '{print $NF}' | xargs)
          local dir="" val="" flags=""
          echo "$line" | grep -qE '(^|[[:space:]])in([[:space:]]|$)' && dir="IN"
          echo "$line" | grep -qE '(^|[[:space:]])out([[:space:]]|$)' && dir="OUT"
          echo "$line" | grep -qE '(^|[[:space:]])hi([[:space:]]|$)' && val="HI"
          echo "$line" | grep -qE '(^|[[:space:]])lo([[:space:]]|$)' && val="LO"
          echo "$line" | grep -qE '(^|[[:space:]])IRQ([[:space:]]|$)' && flags="IRQ"
          echo "$line" | grep -q 'ACTIVE LOW' && flags="${flags} LO"
          printf "%-10s  %-5s  %-28s  %-4s  %-3s  %s\n" "${chip:-?}" "GPIO$num" "${label:0:28}" "${dir:--}" "${val:--}" "$flags"
        fi
      done <<< "$raw"
    } > "$tmpfile"
  fi

  whiptail --textbox "$tmpfile" 24 80 --scrolltext
  rm -f "$tmpfile"
}

do_hdmi_status() {
  local msg=""
  for f in /sys/class/drm/card*-*/status; do
    if [ -f "$f" ]; then
      local conn_dir="${f%/status}"
      local name=$(echo "$f" | sed 's|.*/\([^/]\+\)-[0-9]\+/status|\1|')
      local state=$(cat "$f" 2>/dev/null)
      local modes=""
      local modes_file="${conn_dir}/modes"
      if [ -f "$modes_file" ]; then
        # Deduplicate: count each resolution, show ×N if >1 (different refresh rates)
        modes=$(awk '
          { cnt[$1]++ }
          END {
            for (m in cnt) {
              if (cnt[m] > 1) print m " (x" cnt[m] ")"; else print m
            }
          }' "$modes_file" 2>/dev/null | sort -rn | tr '\n' ' ')
      fi
      # Show active mode if connected
      local active=""
      if [ "$state" = "connected" ]; then
        local enabled_file="${conn_dir}/enabled"
        if [ -f "$enabled_file" ] && [ "$(cat "$enabled_file")" = "enabled" ]; then
          if [ -f "$modes_file" ]; then
            active=" [Current: $(head -1 "$modes_file")]"
          fi
        fi
      fi
      msg="${msg}Connector: ${name}\n  Status: ${state}${active}\n  Supported: ${modes:-none}\n\n"
    fi
  done
  [ -z "$msg" ] && msg="No DRM connectors found.\n\nTry: cat /sys/class/drm/*/status"
  whiptail --msgbox "HDMI / Display Status:\n\n${msg}" 22 72
}

do_resolution_robopi() {
