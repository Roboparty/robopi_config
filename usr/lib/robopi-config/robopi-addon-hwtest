#!/bin/bash
set -u

WS2812_BIN=${WS2812_BIN:-robopi-ws2812}
SIG_DUAL_TEST=${SIG_DUAL_TEST:-/usr/lib/robopi-config/robopi-sig-dual-output-test}
[ -f "$SIG_DUAL_TEST" ] || SIG_DUAL_TEST="$(dirname "$0")/robopi-sig-dual-output-test"

usage() {
  cat <<'EOF'
Usage: robopi-addon-hwtest COMMAND

Commands:
  status              Check package, commands and GPIO devices
  ws2812-demo         Run the WS2812 demonstration
  ws2812-red          Set all WS2812 pixels to dim red
  ws2812-green        Set all WS2812 pixels to dim green
  ws2812-blue         Set all WS2812 pixels to dim blue
  ws2812-off          Turn all WS2812 pixels off
  sig-dual-high       SIG rising edge drives GPIO1_B0 and GPIO0_C2 high
EOF
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "This hardware test must run as root." >&2
    exit 1
  fi
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command is not installed: $1" >&2
    echo "Install the robopi-addon package first." >&2
    exit 2
  fi
}

show_status() {
  echo "========== RoboPi Addon Status =========="
  echo
  if ! dpkg-query -W -f='Package: ${Package}\nVersion: ${Version}\nStatus: ${Status}\n' robopi-addon 2>/dev/null; then
    echo "Package: robopi-addon (not installed)"
  fi
  echo
  for cmd in "$WS2812_BIN"; do
    if command -v "$cmd" >/dev/null 2>&1; then
      echo "$cmd: $(command -v "$cmd")"
    else
      echo "$cmd: NOT FOUND"
    fi
  done
  [ -f "$SIG_DUAL_TEST" ] && \
    echo "SIG dual-output test: $SIG_DUAL_TEST" || \
    echo "SIG dual-output test: NOT FOUND"
  echo
  for chip in /dev/gpiochip0 /dev/gpiochip1; do
    [ -e "$chip" ] && echo "$chip: present" || echo "$chip: missing"
  done
  [ -e /dev/robopi-ws2812 ] && \
    echo "/dev/robopi-ws2812: present" || \
    echo "/dev/robopi-ws2812: missing"
}

require_root

case "${1:-}" in
  status) show_status ;;
  ws2812-demo) require_command "$WS2812_BIN"; exec "$WS2812_BIN" demo ;;
  ws2812-red) require_command "$WS2812_BIN"; exec "$WS2812_BIN" solid 32 0 0 ;;
  ws2812-green) require_command "$WS2812_BIN"; exec "$WS2812_BIN" solid 0 32 0 ;;
  ws2812-blue) require_command "$WS2812_BIN"; exec "$WS2812_BIN" solid 0 0 32 ;;
  ws2812-off) require_command "$WS2812_BIN"; exec "$WS2812_BIN" off ;;
  sig-dual-high) exec bash "$SIG_DUAL_TEST" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
